Назначение: добавить в OpenSBI устройство system-reset для SoC Sophgo
CV1800B/SG2002. В mainline-OpenSBI (PLATFORM=generic) для этого чипа нет
драйвера reset, поэтому вызов SBI SRST превращается в no-op. Linux при
reboot откатывается на DesignWare watchdog, который делает лишь частичный
сброс, и SoC зависает на следующей загрузке.

Драйвер повторяет последовательность vendor FSBL __system_reset(): сначала
включает в RTCSYS маршрутизацию сброса от watchdog, затем взводит DW TOP
watchdog, чей таймаут превращается в полный сброс чипа, с которого плата
поднимается. Проверено на железе. Shutdown запрашивает конечный автомат
power-off RTC.

Драйвер сопоставляется по compatible "sophgo,cv1800b-sysreset" с узлом в
control DTB (u-boot.dtb), который OpenSBI использует в runtime через
FW_FDT_PATH. Узел добавляется отдельным патчем в U-Boot.

Состав патча:
- lib/utils/reset/fdt_reset_cv1800b.c новый драйвер fdt_reset
- lib/utils/reset/objects.mk регистрация carray + объектника под
  CONFIG_FDT_RESET_CV1800B
- lib/utils/reset/Kconfig опция FDT_RESET_CV1800B
- platform/generic/configs/defconfig включение CONFIG_FDT_RESET_CV1800B=y

diff -urN a/lib/utils/reset/fdt_reset_cv1800b.c b/lib/utils/reset/fdt_reset_cv1800b.c
--- a/lib/utils/reset/fdt_reset_cv1800b.c	1970-01-01 03:00:00.000000000 +0300
+++ b/lib/utils/reset/fdt_reset_cv1800b.c	2026-07-03 20:02:36.252396492 +0300
@@ -0,0 +1,105 @@
+/*
+ * SPDX-License-Identifier: BSD-2-Clause
+ *
+ * Sophgo CV1800B / SG2002 RTCSYS system-reset driver.
+ *
+ * Mainline OpenSBI has no reset device for this SoC, so SBI SRST is a
+ * no-op and a plain DesignWare-watchdog reset from Linux is only partial:
+ * the SoC hangs on the next boot. This driver replicates the vendor FSBL
+ * __system_reset() sequence: it enables the RTCSYS watchdog-reset routing
+ * and then arms the DW TOP watchdog, whose timeout is turned into a full
+ * chip reset that the board recovers from. Shutdown requests the RTC
+ * power-off state machine.
+ */
+
+#include <libfdt.h>
+#include <sbi/riscv_asm.h>
+#include <sbi/riscv_io.h>
+#include <sbi/sbi_bitops.h>
+#include <sbi/sbi_error.h>
+#include <sbi/sbi_system.h>
+#include <sbi/sbi_timer.h>
+#include <sbi_utils/fdt/fdt_driver.h>
+#include <sbi_utils/fdt/fdt_helper.h>
+
+/* RTCSYS (persistent VDDBKUP domain) */
+#define REG_EN_SHDN_REQ		((void *)0x050260c0UL)
+#define REG_EN_PWR_CYC_REQ	((void *)0x050260c8UL)
+#define REG_EN_WDT_RST_REQ	((void *)0x050260e0UL)
+#define REG_RSTN_SRC_SEL	((void *)0x050250acUL)
+#define REG_CTRL_UNLOCKKEY	((void *)0x05025004UL)
+#define REG_CTRL		((void *)0x05025008UL)
+#define CTRL_UNLOCKKEY_MAGIC	0xab18
+#define CTRL_EN_WDT_RST		0x00400040	/* route wdt bite -> full RTC reset */
+#define CTRL_REQ_SHDN		0x00010001	/* BIT0: shutdown request */
+
+/* DesignWare TOP watchdog */
+#define WDT_CR			((void *)0x03010000UL)
+#define WDT_TORR		((void *)0x03010004UL)
+#define WDT_CRR			((void *)0x0301000cUL)
+#define WDT_1C			((void *)0x0301001cUL)
+#define WDT_TORR_166MS		0x66
+#define WDT_CRR_KICK		0x76
+#define WDT_CR_ARM		0x11		/* WDT_EN | reset-mode | RPL */
+
+static void cv1800b_rtc_route_wdt_reset(void)
+{
+	writel(0x1, REG_EN_WDT_RST_REQ);
+	writel(0x1, REG_EN_PWR_CYC_REQ);
+	sbi_timer_udelay(100);
+	writel(0x0, REG_RSTN_SRC_SEL);
+	writel(CTRL_UNLOCKKEY_MAGIC, REG_CTRL_UNLOCKKEY);
+	writel(CTRL_EN_WDT_RST, REG_CTRL);
+}
+
+static int cv1800b_system_reset_check(u32 type, u32 reason)
+{
+	switch (type) {
+	case SBI_SRST_RESET_TYPE_COLD_REBOOT:
+	case SBI_SRST_RESET_TYPE_WARM_REBOOT:
+	case SBI_SRST_RESET_TYPE_SHUTDOWN:
+		return 1;
+	}
+	return 0;
+}
+
+static void cv1800b_system_reset(u32 type, u32 reason)
+{
+	cv1800b_rtc_route_wdt_reset();
+
+	if (type == SBI_SRST_RESET_TYPE_SHUTDOWN) {
+		writel(CTRL_UNLOCKKEY_MAGIC, REG_CTRL_UNLOCKKEY);
+		writel(CTRL_REQ_SHDN, REG_CTRL);
+	} else {
+		writel(WDT_TORR_166MS, WDT_TORR);
+		writel(0x20, WDT_1C);
+		writel(WDT_CRR_KICK, WDT_CRR);
+		writel(WDT_CR_ARM, WDT_CR);
+	}
+
+	while (1)
+		wfi();
+}
+
+static struct sbi_system_reset_device cv1800b_reset = {
+	.name = "cv1800b-rtcsys-reset",
+	.system_reset_check = cv1800b_system_reset_check,
+	.system_reset = cv1800b_system_reset,
+};
+
+static int cv1800b_reset_init(const void *fdt, int nodeoff,
+			      const struct fdt_match *match)
+{
+	sbi_system_reset_add_device(&cv1800b_reset);
+	return 0;
+}
+
+static const struct fdt_match cv1800b_reset_match[] = {
+	{ .compatible = "sophgo,cv1800b-sysreset" },
+	{ },
+};
+
+const struct fdt_driver fdt_reset_cv1800b = {
+	.match_table = cv1800b_reset_match,
+	.init = cv1800b_reset_init,
+};
